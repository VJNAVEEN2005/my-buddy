{
  "manifest_version": 3,
  "name": "My Buddy for Chrome",
  "version": "0.1.0",
  "description": "Lets the My Buddy desktop app read and work tabs in this browser, with your own sign-ins.",
  "key": "",
  "permissions": ["tabs", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" }
}
